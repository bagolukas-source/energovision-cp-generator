{
  "_comment": "Zmluva (kontrakt) route POST /webhook/generuj-dokumenty-inline medzi generátorom (energovision-cp-generator) a partnerskym portalom. Povodny zdroj: generator, tests/fixtures/inline_documents_contract.json. Kopia v portali musi byt bajt po bajte rovnaka — obe strany testuju voci nej. Vsetky udaje su vymyslene.",
  "version": 1,
  "route": "/webhook/generuj-dokumenty-inline",
  "auth_header": "X-Webhook-Secret",
  "top_level_keys": ["kind", "lead_data", "allow_docx_only"],
  "kinds": {
    "zmluva": {
      "required": ["meno_priezvisko", "adresa", "telefon", "email", "vykon_kwp", "cislo_cp", "datum_cp", "miesto_vykonu", "cena_eur", "datum_dnes", "payment_terms"],
      "optional": ["panel_sku", "zaruka_panely_produkt", "zaruka_panely_linear"],
      "notes": "Zaruky: bud panel_sku, alebo oba explicitne zaruka_panely_* (nie oboje, nie ziadne)."
    },
    "splnomocnenie": {
      "required": ["meno_priezvisko", "cislo_op", "datum_narodenia", "datum_dnes"],
      "optional": ["trvale_bydlisko", "adresa"],
      "notes": "Aspon jedno z trvale_bydlisko / adresa."
    },
    "gdpr": {
      "required": ["meno_priezvisko", "datum_narodenia", "datum_dnes"],
      "optional": []
    }
  },
  "fields": {
    "meno_priezvisko": {"type": "text", "min": 3, "max": 120},
    "adresa": {"type": "text", "min": 5, "max": 200},
    "trvale_bydlisko": {"type": "text", "min": 5, "max": 200},
    "miesto_vykonu": {"type": "text", "min": 5, "max": 200},
    "telefon": {"type": "text", "min": 7, "max": 30},
    "email": {"type": "text", "min": 6, "max": 254},
    "cislo_cp": {"type": "text", "min": 3, "max": 40},
    "cislo_op": {"type": "text", "min": 5, "max": 20},
    "datum_cp": {"type": "date", "format": "DD.MM.YYYY"},
    "datum_dnes": {"type": "date", "format": "DD.MM.YYYY"},
    "datum_narodenia": {"type": "date", "format": "DD.MM.YYYY"},
    "vykon_kwp": {"type": "number", "min": 0.1, "max": 1000.0, "max_decimals": 2},
    "cena_eur": {"type": "number", "min": 1.0, "max": 5000000.0, "max_decimals": 2},
    "payment_terms": {"type": "enum", "values": ["60_30_10", "60_40", "50_50", "30_70"]},
    "panel_sku": {"type": "enum", "values": ["PAN-001", "PAN-002"]},
    "zaruka_panely_produkt": {"type": "int", "min": 2, "max": 40},
    "zaruka_panely_linear": {"type": "int", "min": 2, "max": 50}
  },
  "request_examples": {
    "zmluva": {
      "kind": "zmluva",
      "lead_data": {
        "meno_priezvisko": "Mária Zákazníková",
        "adresa": "Ukážková 12, 811 01 Bratislava",
        "telefon": "+421 900 000 000",
        "email": "maria.zakaznikova@example.test",
        "vykon_kwp": 10.7,
        "cislo_cp": "PP-2026-0001",
        "datum_cp": "05.11.2026",
        "miesto_vykonu": "Ukážková 12, 811 01 Bratislava",
        "cena_eur": 15689.17,
        "datum_dnes": "12.11.2026",
        "payment_terms": "60_30_10",
        "zaruka_panely_produkt": 25,
        "zaruka_panely_linear": 30
      }
    },
    "splnomocnenie": {
      "kind": "splnomocnenie",
      "lead_data": {
        "meno_priezvisko": "Mária Zákazníková",
        "cislo_op": "ZZ0001234",
        "datum_narodenia": "01.02.1980",
        "trvale_bydlisko": "Ukážková 12, 811 01 Bratislava",
        "datum_dnes": "12.11.2026"
      }
    },
    "gdpr": {
      "kind": "gdpr",
      "lead_data": {
        "meno_priezvisko": "Mária Zákazníková",
        "datum_narodenia": "01.02.1980",
        "datum_dnes": "12.11.2026"
      }
    }
  },
  "response_ok": {
    "status": 200,
    "keys": {
      "ok": "boolean",
      "kind": "string",
      "filename": "string",
      "docx_base64": "string",
      "pdf_base64": "string|null",
      "docx_sha256": "string(hex64)",
      "pdf_sha256": "string(hex64)|null",
      "converter": "string|null",
      "template_sha256": "string(hex64)"
    },
    "filenames": {"zmluva": "Zmluva_o_dielo.docx", "splnomocnenie": "Splnomocnenie.docx", "gdpr": "GDPR_suhlas.docx"},
    "converters": ["gotenberg-libreoffice", "libreoffice"]
  },
  "response_errors": {
    "401": {"ok": false, "error": "unauthorized"},
    "503_unconfigured": {"ok": false, "error": "server misconfigured"},
    "503_no_converter": {"ok": false, "error": "pdf_converter_unavailable", "message": "string"},
    "413": {"ok": false, "error": "payload_too_large", "max_bytes": 16384},
    "422_validation": {"ok": false, "error": "validation_failed", "fields": {"<field>": "string"}},
    "422_incomplete": {"ok": false, "error": "document_incomplete", "problems": ["string"]},
    "500": {"ok": false, "error": "render_failed"}
  }
}
